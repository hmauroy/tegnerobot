{
  "permissions": {
    "deny": [
      "Read(~/.ssh/**)",
      "Read(~/.env)",
      "Edit(~/**)",
      "Bash(rm -rf *)"
    ],
    "ask": [
      "Bash(git push:*)",
      "Bash(npm install:*)"
    ],
    "allow": [
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(npm test:*)",
      "Bash(npm run build:*)"
    ]
  }
}
